# --------- Supabase ---------
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API → service_role (NOT anon!)
# 절대 iOS 앱이나 git에 올리지 말 것. RLS를 우회하는 마스터 키.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --------- TMDB ---------
# https://www.themoviedb.org/settings/api → API Read Access Token (v4)
TMDB_BEARER_TOKEN=eyJ...

# --------- 크롤 옵션 ---------
# 시작 날짜 필터 'YYYY-MM-DD' — 이 날짜 이후 첫방한 드라마만. 빈 값/미설정 = 전체.
# 예: 2021-01-01 → 2021년 이후 KR 드라마 전부
CRAWL_START_DATE=2021-01-01

# 안전 상한 — TMDB total_pages 가 더 작으면 자동으로 거기서 종료.
# 페이지당 20건. 50 = 최대 1000건, 100 = 최대 2000건.
# 2021~ 전체는 약 75~80 페이지 (~1500건) 예상 → 100이면 안전.
CRAWL_MAX_PAGES=100
