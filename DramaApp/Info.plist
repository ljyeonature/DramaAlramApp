<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  OAuth 콜백 수신용 커스텀 URL 스킴.
	  Supabase Auth 는 로그인 성공 후 dramaapp://auth-callback?code=... 로 리다이렉트.
	  Supabase 대시보드 Authentication → URL Configuration 에도 동일 URL 을
	  Redirect URLs 목록에 등록해야 합니다.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.code.review.public.DramaApp.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dramaapp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
